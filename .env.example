# OpenAI-compatible LLM (optional — demo fixture works without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Emails must exist in your PayPal sandbox business/personal test accounts
PAYPAL_INVOICER_EMAIL=your-sandbox-business@example.com
PAYPAL_INVOICER_NAME=Your Studio Name
